# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.19.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=aegis-pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV WRANGLER_WRITE_LOGS=false
ENV WRANGLER_LOG_PATH=/tmp/wrangler-logs
ENV MINIFLARE_REGISTRY_PATH=/data/registry
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/drizzle ./drizzle
COPY wrangler.pi.jsonc ./wrangler.pi.jsonc
COPY scripts/start-aegis-pi.sh ./scripts/start-aegis-pi.sh

RUN mkdir -p /data/wrangler /data/registry /tmp/wrangler-logs \
    && chown -R node:node /app /data /tmp/wrangler-logs \
    && chmod 0555 /app/scripts/start-aegis-pi.sh

USER node
EXPOSE 3000
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

ENTRYPOINT ["/app/scripts/start-aegis-pi.sh"]
