# Local HTTP port for Aegis on the Raspberry Pi.
AEGIS_HTTP_PORT=3000

# Required only for the optional public HTTPS profile.
AEGIS_DOMAIN=security.example.com

# The isolated scanner remains in safe mock mode by default.
AEGIS_LIVE_SCANS=0
AEGIS_ALLOWED_TARGETS=staging.example.com,api.staging.example.com
